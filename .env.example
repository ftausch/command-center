# Copy to .env.local and fill in. Without these the app stays in mock-data mode
# and the build/preview keep working.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose to the browser. Used by admin helpers and the
# Slack webhook handler. Loaded only inside files that import 'server-only'.
SUPABASE_SERVICE_ROLE_KEY=

# Slack slash-command signing secret. Found in your Slack App settings under
# "Basic Information" → "App Credentials" → "Signing Secret".
# Used to verify that POST /api/slack/commands requests originate from Slack.
# NEVER expose this value client-side or log it.
SLACK_SIGNING_SECRET=
