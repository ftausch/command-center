# Copy to .env.local and fill in. Without these the app stays in mock-data mode
# and the build/preview keep working.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose to the browser. Used by admin helpers and the
# Slack webhook handler. Loaded only inside files that import 'server-only'.
SUPABASE_SERVICE_ROLE_KEY=
